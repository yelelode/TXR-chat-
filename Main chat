local function refreshAutoComplete(rawText)
    for _, c in ipairs(acScroll:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
    local cmdPrefix = rawText:match("^([!/][%w_]*)$")
    local dmUserPrefix = rawText:match("^!p%s+([%w_]*)$")
    local mentionPrefix = rawText:match("@([%w_]*)$")
    local suggestions = {}

    if cmdPrefix then
        local q = cmdPrefix:sub(2):lower()
        local cmds = {
            { label = "!p <user>  •  Direct DM", fill = "!p " },
            { label = "/help  •  Commands", fill = "/help" }
        }
        for _, item in ipairs(cmds) do
            if q == "" or item.fill:lower():find(q, 1, true) then table.insert(suggestions, { text = item.label, replaceMode = "full", val = item.fill }) end
        end
    elseif dmUserPrefix ~= nil or mentionPrefix ~= nil then
        local q = (dmUserPrefix or mentionPrefix or ""):lower()
        local isDM, seen = (dmUserPrefix ~= nil), {}

        if not isDM then
            if q == "" or ("all"):find(q, 1, true) then
                table.insert(suggestions, { text = "@all  •  Global Ping", replaceMode = "mention", val = "@all " })
            end
            if q == "" or ("here"):find(q, 1, true) then
                table.insert(suggestions, { text = "@here  •  Active Ping", replaceMode = "mention", val = "@here " })
            end
        end

        local function considerActiveUser(uName, dName)
            if uName:lower() == lp.Name:lower() or seen[uName:lower()] then return end
            if uName:lower() == "system" or dName:lower():find("ai") then return end
            if q == "" or uName:lower():find(q, 1, true) or dName:lower():find(q, 1, true) then
                seen[uName:lower()] = true
                table.insert(suggestions, {
                    text = "@ " .. dName,
                    replaceMode = isDM and "dm" or "mention",
                    val = isDM and ("!p " .. uName .. " ") or ("@" .. uName .. " ")
                })
            end
        end

        for _, info in pairs(activeUsersTable) do
            if type(info) == "table" and info.user then considerActiveUser(info.user, info.disp) end
        end
    end

    if #suggestions > 0 then
        for i = 1, math.min(8, #suggestions) do
            local s = suggestions[i]
