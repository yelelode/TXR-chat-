-- =========================================================
for _, item in ipairs(_G.TXR_GlobalHistoryCache) do
    if item.user and item.msg then
        if item.key then processedServerMessageMap[item.key] = true end
        addMessageToFeed(item.user, item.msg, nil, false, game.JobId, "global", item.t)
