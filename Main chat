local function applySpringHover(btn)
    local btnScale = btn:FindFirstChildOfClass("UIScale") or Instance.new("UIScale", btn)
    btn.MouseEnter:Connect(function() TweenService:Create(btnScale, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1.05}):Play() end)
    btn.MouseLeave:Connect(function() TweenService:Create(btnScale, TweenInfo.new(0.18, Enum.EasingStyle.Quart), {Scale = 1}):Play() end)
    btn.MouseButton1Down:Connect(function() TweenService:Create(btnScale, TweenInfo.new(0.08, Enum.EasingStyle.Sine), {Scale = 0.93}):Play() end)
    btn.MouseButton1Up:Connect(function() TweenService:Create(btnScale, TweenInfo.new(0.25, Enum.EasingStyle.Elastic), {Scale = 1.05}):Play() end)
end

