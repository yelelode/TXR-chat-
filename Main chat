    local isSystemAI = (actualUsername == "System")
    if isSystemAI then dispName = "TXR // AI" end

    local isSelf = (actualUsername:lower() == lp.Name:lower())
    local isMentioned = (not isSystemAI) and (
        string.find(string.lower(displayMsg), string.lower(lp.Name), 1, true) or 
        string.find(string.lower(displayMsg), string.lower(lp.DisplayName), 1, true) or
        (replyToName and (replyToName:lower() == lp.DisplayName:lower() or replyToName:lower() == lp.Name:lower()))
