            local mouseLoc = UserInputService:GetMouseLocation()
            local btnAbsCenter = openBtnContainer.AbsolutePosition + (openBtnContainer.AbsoluteSize / 2)
            local mPos = Vector2.new(mouseLoc.X, mouseLoc.Y)
            local mDist = (mPos - btnAbsCenter).Magnitude
