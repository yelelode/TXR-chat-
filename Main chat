                    local depth = math.cos(a)
                    orb.Position = UDim2.new(0.5, math.cos(a) * (rBase * 0.2), 0.5, math.sin(a) * rBase)
                    orb.Size = UDim2.fromOffset(3.5 + (depth * 2.5), 3.5 + (depth * 2.5))
                    orb.ZIndex = depth > 0 and 106 or 102
                    orb.BackgroundColor3 = baseColor2
                else
                    local a = activeT * 2.5 + offset
                    local depth = math.sin(a + math.pi / 4)
                    orb.Position = UDim2.new(0.5, math.sin(a) * rBase, 0.5, math.sin(a * 2) * (rBase * 0.5))
                    orb.Size = UDim2.fromOffset(4 + (depth * 2), 4 + (depth * 2))
                    orb.ZIndex = 107
                    orb.BackgroundColor3 = Color3.new(1,1,1)
