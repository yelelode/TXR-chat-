-- 📡 SEND MESSAGE (WITH GLOBAL PERSISTENCE & SWIPE QUOTE)
-- =========================================================
local lastSendTick = 0
sendMessageFunc = function(overrideText)
    local text = overrideText or chatInput.Text
    if not text then return end
    if text == "TextBox" then text = "" end
    text = text:gsub("^%s+", ""):gsub("%s+$", "")
    
    if text == "" or (tick() - lastSendTick < 0.15) then return end
    lastSendTick = tick()
    autoCompleteBar.Visible = false

    local pMatch = text:match("^!p%s+(%w+)")
    if pMatch then
        chatInput.Text = ""; privateTarget = pMatch; updateInputBar()
        addMessageToFeed("System::TXR // AI", "Direct DM link locked with " .. pMatch, nil, false, game.JobId, chatMode)
        return
    end

    if text:lower() == "/help" then
        chatInput.Text = ""
        addMessageToFeed("System::TXR // AI", "Commands: '@all' for Global Mention | '!p <user>' for Private DM.", nil, false, game.JobId, chatMode)
        return
    end

    if activeEditData then
        local formattedBody = sanitizeXml(text)
        formattedBody = formattedBody:gsub("(@%w+)", "<font color='#FFCD46'><b>%1</b></font>")
        activeEditData.label.Text = formattedBody .. "  <font color='#8A9AB5' size='9'><i>(edited)</i></font>"
        clearReplyBanner()
        chatInput.Text = ""
        playSFX("default")
        return
    end

    local payloadBodyText = text
    if activeReplyData then
        payloadBodyText = string.format("[REP:%s|%s] %s", activeReplyData.disp, activeReplyData.text, text)
        clearReplyBanner()
    end

    local finalMsg = payloadBodyText
    local currentScope = chatMode

    if privateTarget then
        finalMsg = "( 🔐 " .. lp.Name .. " Private " .. privateTarget .. ") " .. payloadBodyText
    else
        finalMsg = (currentScope == "server") and ("[SRV:" .. tostring(game.JobId) .. "] " .. payloadBodyText) or ("[GLB] " .. payloadBodyText)
    end

    if not overrideText then chatInput.Text = "" end
    local encodedUserTag = lp.Name .. "::" .. lp.DisplayName

    if privateTarget then
        addMessageToFeed(encodedUserTag, payloadBodyText, privateTarget, true, game.JobId, currentScope)
    else
        addMessageToFeed(encodedUserTag, payloadBodyText, nil, false, game.JobId, currentScope)
        if currentScope == "global" then
            saveGlobalMessageToDisk(encodedUserTag, payloadBodyText, encodedUserTag .. "_" .. tostring(math.floor(tick())) .. "_" .. payloadBodyText)
        end
    end
    displayBubble(lp.Name, text)

    recentLocalSentMap[string.lower(finalMsg)] = tick()
    recentLocalSentMap[string.lower(payloadBodyText)] = tick()
    recentLocalSentMap[string.lower(text)] = tick()

    task.spawn(function()
        local fn = (syn and syn.request) or (http and http.request) or http_request or request
        if fn then
            local payload = HttpService:JSONEncode({ user = encodedUserTag, msg = finalMsg, jobId = game.JobId })
            pcall(function()
                fn({
                    Url = SERVER_URL .. "/send", Method = "POST",
                    Headers = { ["Content-Type"] = "application/json", ["User-Agent"] = "Roblox/WinInet" },
                    Body = payload
                })
            end)
        end
    end)
end

sendBtn.MouseButton1Click:Connect(function() sendMessageFunc() end)
chatInput.FocusLost:Connect(function(enterPressed) if enterPressed then sendMessageFunc() end end)

