                eventGlow.ImageTransparency = 0.1 + (math.sin(activeT * 10) * 0.05)
            else
                openBtn.Size = openBtn.Size:Lerp(baseOrbScale, dt * 12)
                openBtn.Position = openBtn.Position:Lerp(baseCenterPos, dt * 12)
                eventGlow.Position = eventGlow.Position:Lerp(baseCenterPos, dt * 12)
                crosshair.Position = crosshair.Position:Lerp(baseCenterPos, dt * 12)
                centerCore.Position = centerCore.Position:Lerp(baseCenterPos, dt * 12)
                eventGlow.ImageTransparency = 0.3 + (math.cos(activeT * 2) * 0.3)
