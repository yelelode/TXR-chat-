                        item.badgeGlow.TextTransparency = 0.42 + (breathPulse * 0.22)
                    end
                else
                    table.remove(activeBadgesList, i)
                end
            end
        end

        if #activeAICoresList > 0 then
            for i = #activeAICoresList, 1, -1 do
                local ai = activeAICoresList[i]
                if ai.grad and ai.grad.Parent and ai.ring and ai.ring.Parent then
                    ai.grad.Rotation = (t * 95) % 360
                    ai.ring.Rotation = -(t * 60) % 360
                    ai.icon.Rotation = math.sin(t * 3) * 18
                else
                    table.remove(activeAICoresList, i)
                end
            end
        end

        if mainFrame.Visible then
            strokeGrad.Rotation = (t * 35) % 360
            local breath = (math.sin(t * 2.5) + 1) / 2
