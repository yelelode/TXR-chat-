                    item.textGrad.Rotation = continuousRotation
                    item.textGrad.Offset = Vector2.new(waveOffset, 0)
                    item.glowGrad.Rotation = continuousRotation
                    item.glowGrad.Offset = Vector2.new(-waveOffset, 0)
                    
                    if item.strokeGradGlow and item.strokeGradGlow.Parent then
                        item.strokeGradGlow.Rotation = (continuousRotation + 180) % 360
                    end
                    if item.shineGrad and item.shineGrad.Parent then
                        local sweep = ((t * 0.8 * sSpeed) % 3.4) - 1.7
                        item.shineGrad.Offset = Vector2.new(sweep, 0)
                    end
                    local breathPulse = (math.sin(t * 2.4 * sSpeed) + 1) / 2
                    if item.glowStroke and item.glowStroke.Parent then
                        item.glowStroke.Thickness = 1.0 + (breathPulse * 0.45)
