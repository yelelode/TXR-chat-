-- 📥 HIGH-FREQUENCY POLLING ENGINE (GLOBAL PERSIST / SERVER WIPE)
-- =========================================================
task.spawn(function()
    while _G.TXR_IsPolling and (_G.TXR_ChatInstanceID == currentExecutionID) and task.wait(0.4) do
        if tostring(game.JobId) ~= CURRENT_SESSION_JOB then
            filterFeedMode()
        end

        if req then
            local success, res = pcall(function()
                return req({
                    Url = SERVER_URL .. "/messages?since=" .. tostring(lastSyncTime),
                    Method = "GET",
                    Headers = { ["User-Agent"] = "Roblox/WinInet" }
                })
            end)

            if success and res and res.StatusCode == 200 then
                local decodeSuccess, data = pcall(function()
                    return HttpService:JSONDecode(res.Body)
                end)

                if decodeSuccess and type(data) == "table" then
                    if isInitialSync then
                        isInitialSync = false
                        if #data > 0 then
                            local startIndex = math.max(1, #data - 15)
                            for i = startIndex, #data do
                                local m = data[i]
                                if not m.hidden and m.msg ~= "Joined" then
                                    local initKey = (m.id and tostring(m.id)) or (m.user .. "_" .. tostring(m.time) .. "_" .. m.msg)
                                    processedServerMessageMap[initKey] = true
                                    
                                    local srvJob, cleanSrvMsg = m.msg:match("^%[SRV:(.-)%]%s*(.*)$")
                                    local cleanGlbMsg = m.msg:match("^%[GLB%]%s*(.*)$")
                                    local scope = "global"
                                    local parsedMsg = m.msg

                                    if srvJob then
                                        scope = "server"
                                        parsedMsg = cleanSrvMsg
                                        if tostring(srvJob) ~= tostring(game.JobId) then continue end
                                    elseif cleanGlbMsg then
                                        scope = "global"
                                        parsedMsg = cleanGlbMsg
                                    end

                                    addMessageToFeed(m.user, parsedMsg, nil, false, m.jobId, scope)
                                    local rawU, rawD = m.user:match("^(.-)::(.*)$")
                                    updateLiveCounter(rawU or m.user, rawD or m.user)
                                end
                            end
                            lastSyncTime = data[#data].time
                        end
                        continue
                    end

                    for _, m in ipairs(data) do
                        local uniqueMsgKey = (m.id and tostring(m.id)) or (m.user .. "_" .. tostring(m.time) .. "_" .. m.msg)
                        if processedServerMessageMap[uniqueMsgKey] then continue end

                        if m.time >= lastSyncTime then
                            lastSyncTime = m.time
                            local rawU, rawD = m.user:match("^(.-)::(.*)$")
                            local rawUsernameOnly = rawU or m.user
                            local rawDispOnly = rawD or rawUsernameOnly
                            knownUsers[rawUsernameOnly:lower()] = rawUsernameOnly
                            updateLiveCounter(rawUsernameOnly, rawDispOnly)

                            if m.msg == "Joined" then
                                processedServerMessageMap[uniqueMsgKey] = true
                                if rawUsernameOnly ~= lp.Name then
                                    addJoinNotice(rawDispOnly)
                                    playSFX("default")
                                end
                                continue
                            end

                            if m.hidden then 
                                processedServerMessageMap[uniqueMsgKey] = true
                                continue 
                            end

                            if rawUsernameOnly:lower() == lp.Name:lower() then
                                local lowMsg = string.lower(m.msg)
                                local isEcho = false
                                for sentText, sentTime in pairs(recentLocalSentMap) do
                                    if (sentText == lowMsg or lowMsg:find(sentText, 1, true)) and (tick() - sentTime <= 60) then
                                        isEcho = true
                                        recentLocalSentMap[sentText] = nil
                                        break
                                    end
                                end
                                if isEcho then
                                    processedServerMessageMap[uniqueMsgKey] = true
                                    continue
                                end
                            end

                            processedServerMessageMap[uniqueMsgKey] = true

                            local srvJob, cleanSrvMsg = m.msg:match("^%[SRV:(.-)%]%s*(.*)$")
                            local cleanGlbMsg = m.msg:match("^%[GLB%]%s*(.*)$")
                            local scope = "global"
                            local effectiveMsg = m.msg

                            if srvJob then
                                scope = "server"
                                effectiveMsg = cleanSrvMsg
                                if tostring(srvJob) ~= tostring(game.JobId) then continue end
                            elseif cleanGlbMsg then
                                scope = "global"
                                effectiveMsg = cleanGlbMsg
                            end

                            local pSender, pTarget, pMsg = string.match(effectiveMsg, "^%( 🔐 ([%w_]+) Private ([%w_]+)%) (.*)$")
                            if pSender and pTarget then
                                if lp.Name == pSender then
                                    addMessageToFeed(m.user, pMsg, pTarget, true, m.jobId, scope)
                                elseif lp.Name == pTarget then
                                    addMessageToFeed(m.user, pMsg, pSender, false, m.jobId, scope)
                                    local _, _, strippedBubble = pMsg:match("^%[REP:([^|]+)|([^%]]+)%]%s*(.*)$")
                                    displayBubble(rawUsernameOnly, strippedBubble or pMsg)
                                    playSFX("dm")
                                    if not mainFrame.Visible then
                                        unreadCount = unreadCount + 1
                                        unreadTxt.Text = tostring(unreadCount)
                                        unreadBadge.Visible = true
                                    end
                                end
                                continue
                            end

                            addMessageToFeed(m.user, effectiveMsg, nil, false, m.jobId, scope)

                            if rawUsernameOnly ~= lp.Name then
                                local _, _, strippedBubble = effectiveMsg:match("^%[REP:([^|]+)|([^%]]+)%]%s*(.*)$")
                                displayBubble(rawUsernameOnly, strippedBubble or effectiveMsg)
                                playSFX("default")
                                if not mainFrame.Visible then
                                    unreadCount = unreadCount + 1
                                    unreadTxt.Text = tostring(unreadCount)
                                    unreadBadge.Visible = true
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)

