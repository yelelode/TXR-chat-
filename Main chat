-- =========================================================
-- 🚀 MULTI-TOUCH SAFE DRAG ENGINE (FULL WINDOW DRAGGABLE)
-- =========================================================
local function makeDraggable(frame, handlesList, ghostAura, isOrb)
    local dragging, activeDragInput, dragStart, startPos, dragLoop = false, nil, nil, nil, nil
    local targetPos, velocity, lastInputPos = frame.Position, Vector2.new(0, 0), Vector2.new(0, 0)

    local function getClampedTarget(newXScale, newXOffset, newYScale, newYOffset)
        local parentSize, frameSize, anchor = gui.AbsoluteSize, frame.AbsoluteSize, frame.AnchorPoint
        if parentSize.X <= 0 or parentSize.Y <= 0 then return UDim2.new(newXScale, newXOffset, newYScale, newYOffset) end
        local absX, absY = (newXScale * parentSize.X) + newXOffset, (newYScale * parentSize.Y) + newYOffset
        local minX, maxX, minY, maxY
        if isOrb then
            minX, maxX = frameSize.X * anchor.X, parentSize.X - (frameSize.X * (1 - anchor.X))
            minY, maxY = frameSize.Y * anchor.Y, parentSize.Y - (frameSize.Y * (1 - anchor.Y))
        else
            local vw, vh = frameSize.X * 0.25, frameSize.Y * 0.25
            minX, maxX = (frameSize.X * anchor.X) - (frameSize.X - vw), parentSize.X - (frameSize.X * (1 - anchor.X)) + (frameSize.X - vw)
            minY, maxY = (frameSize.Y * anchor.Y) - (frameSize.Y - vh), parentSize.Y - (frameSize.Y * (1 - anchor.Y)) + (frameSize.Y - vh)
        end
        if minX > maxX then minX, maxX = maxX, minX end
        if minY > maxY then minY, maxY = maxY, minY end
        return UDim2.new(newXScale, math.clamp(absX, minX, maxX) - (newXScale * parentSize.X), newYScale, math.clamp(absY, minY, maxY) - (newYScale * parentSize.Y))
    end

    for _, handle in ipairs(handlesList) do
        handle.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging, activeDragInput, dragStart, startPos, targetPos = true, input, input.Position, frame.Position, frame.Position
                lastInputPos, velocity = Vector2.new(input.Position.X, input.Position.Y), Vector2.new(0, 0)
                if not isOrb then TweenService:Create(dragPill, TweenInfo.new(0.2), {Size = UDim2.fromOffset(60, 4), BackgroundTransparency = 0.12}):Play()
                else isDraggingOrb, dragThresholdMet = true, false end
                if dragLoop then dragLoop:Disconnect() end
                dragLoop = RunService.RenderStepped:Connect(function(dt)
                    if _G.TXR_ChatInstanceID ~= currentExecutionID then dragLoop:Disconnect(); return end
                    if dragging then
                        frame.Position = frame.Position:Lerp(targetPos, math.clamp(dt * 28, 0, 1))
                    else
                        if velocity.Magnitude > 0.5 then
                            velocity = velocity * 0.88
                            targetPos = getClampedTarget(targetPos.X.Scale, targetPos.X.Offset + velocity.X, targetPos.Y.Scale, targetPos.Y.Offset + velocity.Y)
                            frame.Position = frame.Position:Lerp(targetPos, math.clamp(dt * 16, 0, 1))
                        else
                            dragLoop:Disconnect(); dragLoop = nil
                        end
                    end
                    if ghostAura then ghostAura.Position = frame.Position; shadow.Position = frame.Position end
                end)
            end
        end)
    end

    UserInputService.InputEnded:Connect(function(input)
        if input == activeDragInput or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging, activeDragInput = false, nil
            if not isOrb then TweenService:Create(dragPill, TweenInfo.new(0.25), {Size = UDim2.fromOffset(40, 3), BackgroundTransparency = 0.55}):Play()
            else isDraggingOrb, orbHovered = false, false end
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input == activeDragInput or input.UserInputType == Enum.UserInputType.MouseMovement) then
            local delta = input.Position - dragStart
            if isOrb and delta.Magnitude > 8 then dragThresholdMet = true end
            targetPos = getClampedTarget(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            local currentMousePos = Vector2.new(input.Position.X, input.Position.Y)
            velocity, lastInputPos = currentMousePos - lastInputPos, currentMousePos
        end
    end)
end

