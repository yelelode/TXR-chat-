    -- Parse Reply Header: [REP:DisplayName|Snippet] RestOfMsg
    local replyToName, replySnippet, cleanBodyMsg = msg:match("^%[REP:([^|]+)|([^%]]+)%]%s*(.*)$")
    local displayMsg = cleanBodyMsg or msg

    local memeIdMatch = displayMsg:match("%[MEME:(%d+)%]")

    local actualUsername, dispName = rawUserName:match("^(.-)::(.*)$")
    if not actualUsername then
        actualUsername = rawUserName
