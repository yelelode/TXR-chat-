    local isSwipingCard = false
    local swipeInputObj = nil
    local swipeStartPos = nil
    local swipeTriggered = false
    local movedDistance = 0

    card.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isSwipingCard = true
            swipeInputObj = input
            swipeStartPos = input.Position
            swipeTriggered = false
            movedDistance = 0
        end
    end)

    local moveConn
    moveConn = UserInputService.InputChanged:Connect(function(input)
        if not card.Parent then moveConn:Disconnect() return end
        if isSwipingCard and (input == swipeInputObj or input.UserInputType == Enum.UserInputType.MouseMovement) then
            local delta = input.Position - swipeStartPos
            movedDistance = delta.Magnitude

            if delta.X > 6 and math.abs(delta.X) > math.abs(delta.Y) * 1.25 then
                local rawX = math.max(0, delta.X - 6)
                local dragOffset = math.clamp(rawX ^ 0.85 * 1.35, 0, 58)
                card.Position = UDim2.fromOffset(dragOffset, 0)

                local progress = math.clamp(dragOffset / 40, 0, 1)
                swipeCapsule.BackgroundTransparency = 1 - (progress * 0.90)
                scFill.Size = UDim2.fromScale(progress, 1)
                scStroke.Transparency = 1 - progress
                swipeLabel.TextTransparency = 1 - progress
                scScale.Scale = 0.65 + (progress * 0.40)

                if dragOffset >= 40 and not swipeTriggered then
                    swipeTriggered = true
                    scFill.BackgroundColor3 = Colors.Purple
                    playSFX("default")
                elseif dragOffset < 40 and swipeTriggered then
                    swipeTriggered = false
                    scFill.BackgroundColor3 = Colors.Primary
                end
            end
        end
    end)

    local endConn
    endConn = UserInputService.InputEnded:Connect(function(input)
        if not card.Parent then endConn:Disconnect() return end
        if isSwipingCard and (input == swipeInputObj or input.UserInputType == Enum.UserInputType.MouseButton1) then
            isSwipingCard = false
            swipeInputObj = nil

            TweenService:Create(card, TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.fromOffset(0, 0)}):Play()
            TweenService:Create(swipeCapsule, TweenInfo.new(0.22), {BackgroundTransparency = 1}):Play()
            TweenService:Create(scStroke, TweenInfo.new(0.22), {Transparency = 1}):Play()
            TweenService:Create(swipeLabel, TweenInfo.new(0.22), {TextTransparency = 1}):Play()
            TweenService:Create(scScale, TweenInfo.new(0.22), {Scale = 0.5}):Play()

            if swipeTriggered then
                swipeTriggered = false
                if activateReplyBanner then
                    local cleanPreview = memeIdMatch and "[Sticker]" or displayMsg
                    if #cleanPreview > 38 then cleanPreview = string.sub(cleanPreview, 1, 38) .. "..." end
                    activateReplyBanner(dispName, cleanPreview)
                end
            elseif movedDistance < 10 then
                if isSelf or isSystemAI then return end
                for _, c in ipairs(actionMenu:GetChildren()) do
                    if c:IsA("TextButton") then c:Destroy() end
                end

                createActionBtn("REPLY", Colors.Primary, function()
                    if activateReplyBanner then
                        local cleanPreview = memeIdMatch and "[Sticker]" or displayMsg
                        if #cleanPreview > 38 then cleanPreview = string.sub(cleanPreview, 1, 38) .. "..." end
                        activateReplyBanner(dispName, cleanPreview)
                    end
                end)

                createActionBtn("DM", Colors.Purple, function()
                    privateTarget = actualUsername
                    updateInputBar()
                    playSFX("dm")
                end)

                createActionBtn("COPY", Colors.Text, function()
                    pcall(function() setClip(memeIdMatch and ("ID: " .. memeIdMatch) or displayMsg) end)
                end)

                createActionBtn("TP", Colors.MentionGold, function()
                    local targetPlr = Players:FindFirstChild(actualUsername)
                    if targetPlr and targetPlr.Character and targetPlr.Character:FindFirstChild("HumanoidRootPart") and lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
                        lp.Character.HumanoidRootPart.CFrame = targetPlr.Character.HumanoidRootPart.CFrame
                    end
                end)

                createActionBtn("VIEW", Colors.PrimaryDark, function()
                    local targetPlr = Players:FindFirstChild(actualUsername)
                    if targetPlr and targetPlr.Character and targetPlr.Character:FindFirstChild("Humanoid") then
                        Camera.CameraSubject = targetPlr.Character.Humanoid
                    end
                end)

                local cardPos = cardWrapper.AbsolutePosition - mainFrame.AbsolutePosition
                actionMenu.Position = UDim2.fromOffset(math.clamp(cardPos.X + 25, 10, 180), math.clamp(cardPos.Y - 24, 30, 280))
                actionMenu.Visible = true
            end
        end
    end)

    task.defer(function()
        local maxOffset = math.max(0, messageFeed.AbsoluteCanvasSize.Y - messageFeed.AbsoluteWindowSize.Y)
        if maxOffset - messageFeed.CanvasPosition.Y < 95 then
            messageFeed.CanvasPosition = Vector2.new(0, maxOffset)
        else
            jumpBottomBtn.Visible = true
        end
    end)
end

