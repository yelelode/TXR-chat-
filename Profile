-- =========================================================
-- 🌟 TXR TITAN: STANDALONE FOLLOWERS VIEWER MODULE
-- =========================================================
return function(config)
    local profileFrame = config.ProfileFrame
    local userId = config.UserId
    local totalCount = config.Count or "--"
    local Colors = config.Colors
    local onUserSelected = config.OnUserSelected or function() end

    if not profileFrame then return end

    -- Existing modal clean up
    local oldModal = profileFrame:FindFirstChild("TXR_FollowersModal")
    if oldModal then oldModal:Destroy() end

    local TweenService = game:GetService("TweenService")
    local HttpService = game:GetService("HttpService")
    local req = (syn and syn.request) or (http and http.request) or http_request or request

    -- Main modal drawer
    local modal = Instance.new("Frame", profileFrame)
    modal.Name = "TXR_FollowersModal"
    modal.Size = UDim2.new(1, 0, 1, 0)
    modal.Position = UDim2.new(0, 0, 1, 0)
    modal.BackgroundColor3 = Colors.Background or Color3.fromRGB(2, 3, 5)
    modal.BackgroundTransparency = 0.02
    modal.ZIndex = 140
    Instance.new("UICorner", modal).CornerRadius = UDim.new(0, 16)

    local header = Instance.new("Frame", modal)
    header.Size = UDim2.new(1, 0, 0, 40)
    header.BackgroundTransparency = 1
    header.ZIndex = 141

    local backBtn = Instance.new("TextButton", header)
    backBtn.Size = UDim2.fromOffset(30, 30)
    backBtn.Position = UDim2.fromOffset(10, 5)
    backBtn.BackgroundTransparency = 1
    backBtn.Text = "←"
    backBtn.TextColor3 = Colors.Primary or Color3.fromRGB(0, 255, 220)
    backBtn.Font = Enum.Font.GothamBlack
    backBtn.TextSize = 14
    backBtn.ZIndex = 142

    local title = Instance.new("TextLabel", header)
    title.Size = UDim2.new(1, -80, 1, 0)
    title.Position = UDim2.fromOffset(40, 0)
    title.BackgroundTransparency = 1
    title.Text = "FOLLOWERS (" .. tostring(totalCount) .. ")"
    title.TextColor3 = Colors.Text or Color3.fromRGB(255, 255, 255)
    title.Font = Enum.Font.GothamBlack
    title.TextSize = 11
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.ZIndex = 142

    local scroll = Instance.new("ScrollingFrame", modal)
    scroll.Size = UDim2.new(1, -20, 1, -50)
    scroll.Position = UDim2.fromOffset(10, 44)
    scroll.BackgroundTransparency = 1
    scroll.ScrollBarThickness = 2
    scroll.ScrollBarImageColor3 = Colors.Primary or Color3.fromRGB(0, 255, 220)
    scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    scroll.ZIndex = 142

    local layout = Instance.new("UIListLayout", scroll)
    layout.Padding = UDim.new(0, 6)

    local function closeModal()
        pcall(function()
            local tw = TweenService:Create(modal, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Position = UDim2.new(0, 0, 1, 0)})
            tw:Play()
            tw.Completed:Connect(function()
                modal:Destroy()
            end)
        end)
    end
    backBtn.MouseButton1Click:Connect(closeModal)

    -- Open Animation
    pcall(function()
        TweenService:Create(modal, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0)}):Play()
    end)

    -- Data Fetch Thread
    task.spawn(function()
        if not req or not userId or userId == 0 then return end

        local r = req({
            Url = "https://friends.roblox.com/v1/users/" .. tostring(userId) .. "/followers?limit=18&sortOrder=Desc",
            Method = "GET"
        })

        if r and r.StatusCode == 200 then
            local data = HttpService:JSONDecode(r.Body)
            if data and data.data then
                for _, fUser in ipairs(data.data) do
                    local row = Instance.new("TextButton", scroll)
                    row.Size = UDim2.new(1, 0, 0, 34)
                    row.BackgroundColor3 = Color3.fromRGB(15, 18, 24)
                    row.BackgroundTransparency = 0.2
                    row.Text = ""
                    row.AutoButtonColor = false
                    row.ZIndex = 143
                    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)

                    local rStroke = Instance.new("UIStroke", row)
                    rStroke.Color = Colors.SurfaceHover or Color3.fromRGB(16, 20, 26)
                    rStroke.Thickness = 1.0

                    local rAvatar = Instance.new("ImageLabel", row)
                    rAvatar.Size = UDim2.fromOffset(26, 26)
                    rAvatar.Position = UDim2.fromOffset(4, 4)
                    rAvatar.BackgroundTransparency = 1
                    rAvatar.Image = string.format("rbxthumb://type=AvatarHeadShot&id=%d&w=48&h=48", fUser.id)
                    rAvatar.ZIndex = 144
                    Instance.new("UICorner", rAvatar).CornerRadius = UDim.new(1, 0)

                    local rName = Instance.new("TextLabel", row)
                    rName.Size = UDim2.new(1, -40, 1, 0)
                    rName.Position = UDim2.fromOffset(36, 0)
                    rName.BackgroundTransparency = 1
                    rName.Text = fUser.displayName .. " (@" .. fUser.name .. ")"
                    rName.TextColor3 = Colors.Text or Color3.fromRGB(255, 255, 255)
                    rName.Font = Enum.Font.GothamBold
                    rName.TextSize = 10
                    rName.TextXAlignment = Enum.TextXAlignment.Left
                    rName.ZIndex = 144

                    row.MouseButton1Click:Connect(function()
                        closeModal()
                        onUserSelected(fUser.name)
                    end)
                end
            end
        end
    end)
end
