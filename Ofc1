openProfile = function(username, dispName, uId, isAdmin, isAI)
    activeProfileUser = username
    pName.Text = dispName
    pUser.Text = "@" .. username
    
    local pData = globalUserProfiles[username] or {}
    local useAvt = pData.Avatar or (username == lp.Name and _G.TXR_CustomAvatarID) or (uId and string.format("rbxthumb://type=AvatarHeadShot&id=%d&w=150&h=150", uId)) or ""
    local useBnr = pData.Banner or (username == lp.Name and _G.TXR_CustomBannerID) or ""
    local useBio = pData.Bio or (username == lp.Name and customUserBios[lp.Name]) or (isAI and "TXR Artificial Intelligence Core.\nMonitoring network anomalies.") or "TXR Cyber Titan Network User.\nExploring the virtual realm."
    local useBadge = pData.Badge or (username == lp.Name and currentOwnerBadge) or "MEMBER"
    
    if isAI then
        pBannerGrad.Color = ColorSequence.new(Colors.Purple, rgb(80, 40, 120))
        pAvatar.BackgroundColor3 = rgb(14, 18, 30)
        useBadge = "AICORE"
    elseif isAdmin then
        pBannerGrad.Color = ColorSequence.new(Colors.Primary, Colors.MentionGold)
    else
        pBannerGrad.Color = ColorSequence.new(Colors.Primary, Colors.Purple)
    end
    
    if useAvt == "" and uId then
        useAvt = string.format("rbxthumb://type=AvatarHeadShot&id=%d&w=150&h=150", uId)
    end
    
    pAvatar.Image = useAvt
    
    if useBnr ~= "" then 
        pBannerImg.Image = useBnr
        pBannerGrad.Enabled = false 
    else 
        pBannerImg.Image = ""
        pBannerGrad.Enabled = true 
    end
    
    pBioText.Text = useBio
    
    for _, child in ipairs(pBadgeContainer:GetChildren()) do 
        child:Destroy() 
    end
    
    if BadgePresets[useBadge] then
        local bHost = buildLiveBadgeElement(pBadgeContainer, BadgePresets[useBadge], 305)
        bHost.AnchorPoint = Vector2.new(0, 0.5)
        bHost.Position = UDim2.new(0, 0, 0.5, 0)
    end

    if username == lp.Name then
        pBioEditBtn.Visible = true
        pAvatarEditOverlay.Visible = true
        pBannerEditOverlay.Visible = true
        pMessageBtn.Text = "Your Profile (Edit Bio Above)"
        pMessageBtn.BackgroundColor3 = Colors.SurfaceHover
        pMessageBtn.TextColor3 = Colors.SubText
