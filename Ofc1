function saveGlobalMessageToDisk(userTag, cleanMsg, msgIdKey)
    for _, item in ipairs(_G.TXR_GlobalHistoryCache) do
        if item.key == msgIdKey then return end
    end
    table.insert(_G.TXR_GlobalHistoryCache, { user = userTag, msg = cleanMsg, key = msgIdKey, t = os.date("%H:%M") })
    while #_G.TXR_GlobalHistoryCache > 45 do 
        table.remove(_G.TXR_GlobalHistoryCache, 1) 
    end
    pcall(function() writeF(GLOBAL_SAVE_FILE, HttpService:JSONEncode(_G.TXR_GlobalHistoryCache)) end)
end

