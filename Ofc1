        pBioEditBtn.Visible = false
        pAvatarEditOverlay.Visible = false
        pBannerEditOverlay.Visible = false
        pMessageBtn.Text = "Direct Message"
        pMessageBtn.BackgroundColor3 = isAI and Colors.Purple or Colors.Primary
        pMessageBtn.TextColor3 = rgb(10, 14, 22)
    end
    
    profileOverlay.Visible = true
    TweenService:Create(profileOverlay, TweenInfo.new(0.3), {BackgroundTransparency = 0.5}):Play()
    profileModal.Visible = true
    TweenService:Create(pmScale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
    playSFX("default")
end

