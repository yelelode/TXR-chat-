    CURRENT_SESSION_JOB = tostring(game.JobId)
    for _, card in ipairs(messageFeed:GetChildren()) do
        if card:IsA("GuiObject") and card.Name ~= "UIListLayout" and card.Name ~= "UIPadding" then
            local cardScope = card:GetAttribute("ChatScope")
            local cardJob = tostring(card:GetAttribute("JobId") or "")
            if cardScope == "server" and cardJob ~= "" and cardJob ~= CURRENT_SESSION_JOB then
                card:Destroy()
                continue
            end
            if chatMode == "server" then 
                card.Visible = (cardScope ~= "global")
            else 
                card.Visible = (cardScope ~= "server") 
            end
        end
    end
    scrollToFeedBottom()
end

