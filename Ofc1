function updateLiveCounter(username, dispName)
    activeUsersTable[username:lower()] = { time = os.time(), disp = dispName or username, user = username }
    local count, now = 0, os.time()
    for u, data in pairs(activeUsersTable) do
        local t = (type(data) == "table" and data.time) or data
        if now - t < 300 then count = count + 1 else activeUsersTable[u] = nil end
    end
    liveText.Text = string.format("%d Active", math.max(1, count))
end

