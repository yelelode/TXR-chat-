local lastSendTick = 0
UI.sendMessageFunc = function(overrideText)
    local text = overrideText or UI.chatInput.Text
    if not text then return end
    if text == "TextBox" then text = "" end
    text = string.gsub(text, "^%s+", ""); text = string.gsub(text, "%s+$", "")
    if text == "" or (tick() - lastSendTick < 0.15) then return end
    lastSendTick = tick()

    local pMatch = text:match("^!p%s+(%w+)")
    if pMatch then UI.chatInput.Text = ""; State.privateTarget = pMatch; UI.updateInputBar(); addMessageToFeed("System::System", "DM mode locked with @" .. pMatch, nil, false, game.JobId, "global"); return end

    local finalMsg = text
    if State.privateTarget then finalMsg = "( 🔐 " .. lp.Name .. " Private " .. State.privateTarget .. ") " .. text
    else finalMsg = (State.chatMode == "server") and ("[SRV:" .. tostring(game.JobId) .. "] " .. text) or ("[GLB] " .. text) end

    if not overrideText then UI.chatInput.Text = "" end
    local encodedUserTag = lp.Name .. "::" .. lp.DisplayName

    if State.privateTarget then addMessageToFeed(encodedUserTag, text, State.privateTarget, true, game.JobId, State.chatMode)
    else addMessageToFeed(encodedUserTag, text, nil, false, game.JobId, State.chatMode) end
    displayBubble(lp.Name, text)

    local cleanKey = string.lower(finalMsg)
    recentLocalSentMap[cleanKey] = tick()

    task.spawn(function()
        if req then
            local payload = HttpService:JSONEncode({ user = encodedUserTag, msg = finalMsg, jobId = game.JobId })
            pcall(function() req({ Url = SERVER_URL .. "/send", Method = "POST", Headers = { ["Content-Type"] = "application/json", ["User-Agent"] = "Roblox/WinInet" }, Body = payload }) end)
        end
    end)
end

UI.sendBtn.MouseButton1Click:Connect(function() UI.sendMessageFunc() end)
UI.chatInput.FocusLost:Connect(function(enterPressed) if enterPressed then UI.sendMessageFunc() end end)

