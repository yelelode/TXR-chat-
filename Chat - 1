            if success and res and res.StatusCode == 200 then
                local decodeSuccess, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
                if decodeSuccess and type(data) == "table" then
                    if isInitialSync then
                        isInitialSync = false
                        if #data > 0 then
                            local startIndex = math.max(1, #data - 6)
                            for i = startIndex, #data do
                                local m = data[i]
                                if not m.hidden and m.msg ~= "Joined" then
                                    local initKey = (m.id and tostring(m.id)) or (m.user .. "_" .. tostring(m.time) .. "_" .. m.msg)
                                    processedServerMessageMap[initKey] = true
                                    local srvJob, cleanSrvMsg = m.msg:match("^%[SRV:(.-)%]%s*(.*)$")
                                    local cleanGlbMsg = m.msg:match("^%[GLB%]%s*(.*)$")
                                    local scope = "global"; local parsedMsg = m.msg
                                    if srvJob then scope = "server"; parsedMsg = cleanSrvMsg; if srvJob ~= game.JobId then continue end
                                    elseif cleanGlbMsg then scope = "global"; parsedMsg = cleanGlbMsg end
                                    addMessageToFeed(m.user, parsedMsg, nil, false, m.jobId, scope)
                                    local rawUsernameOnly = m.user:match("^(.-)::") or m.user; updateLiveCounter(rawUsernameOnly)
                                end
                            end
                            lastSyncTime = data[#data].time
                        end
                        continue
                    end

                    for _, m in ipairs(data) do
                        local uniqueMsgKey = (m.id and tostring(m.id)) or (m.user .. "_" .. tostring(m.time) .. "_" .. m.msg)
                        if processedServerMessageMap[uniqueMsgKey] then continue end

                        if m.time >= lastSyncTime then
                            lastSyncTime = m.time
                            local rawUsernameOnly = m.user:match("^(.-)::") or m.user
                            knownUsers[rawUsernameOnly:lower()] = rawUsernameOnly; updateLiveCounter(rawUsernameOnly)

                            if m.msg == "Joined" then
