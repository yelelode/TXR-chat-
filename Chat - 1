                                continue
                            end

                            if m.hidden then 
                                processedServerMessageMap[uniqueMsgKey] = true
                                if m.msg == "[TYPING]" and rawUsernameOnly ~= lp.Name then globalTypers[rawUsernameOnly] = tick()
                                elseif m.msg == "[STOP_TYPING]" and rawUsernameOnly ~= lp.Name then globalTypers[rawUsernameOnly] = nil end
                                continue 
                            end

                            if rawUsernameOnly:lower() == lp.Name:lower() then
                                local lowMsg = string.lower(m.msg); local isEcho = false
                                for sentText, sentTime in pairs(recentLocalSentMap) do
                                    if (sentText == lowMsg or lowMsg:find(sentText, 1, true)) and (tick() - sentTime <= 60) then isEcho = true; recentLocalSentMap[sentText] = nil; break end
                                end
                                if isEcho then processedServerMessageMap[uniqueMsgKey] = true; continue end
                            end

                            processedServerMessageMap[uniqueMsgKey] = true
                            local srvJob, cleanSrvMsg = m.msg:match("^%[SRV:(.-)%]%s*(.*)$")
                            local cleanGlbMsg = m.msg:match("^%[GLB%]%s*(.*)$")
                            local scope = "global"; local effectiveMsg = m.msg

                            if srvJob then scope = "server"; effectiveMsg = cleanSrvMsg; if srvJob ~= game.JobId then continue end
                            elseif cleanGlbMsg then scope = "global"; effectiveMsg = cleanGlbMsg end

                            local pSender, pTarget, pMsg = string.match(effectiveMsg, "^%( 🔐 ([%w_]+) Private ([%w_]+)%) (.*)$")
                            if pSender and pTarget then
                                if lp.Name == pSender then addMessageToFeed(m.user, pMsg, pTarget, true, m.jobId, scope)
