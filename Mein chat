local function applySpringHover(btn)
    local btnScale = btn:FindFirstChildOfClass("UIScale") or Instance.new("UIScale", btn)
    local originalColor = btn.BackgroundColor3
    local originalTransparency = btn.BackgroundTransparency
    btn.MouseEnter:Connect(function()
        TweenService:Create(btnScale, TweenInfo.new(0.25, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {Scale = 1.03}):Play()
        if btn.BackgroundTransparency < 1 then TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Colors.SurfaceHover, BackgroundTransparency = math.max(0, originalTransparency - 0.1)}):Play() end
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btnScale, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Scale = 1}):Play()
        if btn.BackgroundTransparency < 1 then TweenService:Create(btn, TweenInfo.new(0.3), {BackgroundColor3 = originalColor, BackgroundTransparency = originalTransparency}):Play() end
    end)
    btn.MouseButton1Down:Connect(function() TweenService:Create(btnScale, TweenInfo.new(0.1, Enum.EasingStyle.Sine), {Scale = 0.95}):Play() end)
    btn.MouseButton1Up:Connect(function() TweenService:Create(btnScale, TweenInfo.new(0.4, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {Scale = 1.03}):Play() end)
end

