local isCurrentlyTypingLocally = false; local lastTypingBroadcast = 0
chatInput:GetPropertyChangedSignal("Text"):Connect(function()
    if #chatInput.Text > 0 then
        typingIndicator.BackgroundTransparency = 0.2
        if not isCurrentlyTypingLocally or (tick() - lastTypingBroadcast > 2.0) then
            isCurrentlyTypingLocally = true; lastTypingBroadcast = tick()
            task.spawn(function() if req then pcall(function() req({ Url = SERVER_URL .. "/send", Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = HttpService:JSONEncode({ user = lp.Name .. "::" .. lp.DisplayName, msg = "[TYPING]", jobId = game.JobId, hidden = true }) }) end) end end)
        end
    else
        typingIndicator.BackgroundTransparency = 1
        if isCurrentlyTypingLocally then
            isCurrentlyTypingLocally = false
            task.spawn(function() if req then pcall(function() req({ Url = SERVER_URL .. "/send", Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = HttpService:JSONEncode({ user = lp.Name .. "::" .. lp.DisplayName, msg = "[STOP_TYPING]", jobId = game.JobId, hidden = true }) }) end) end end)
        end
    end
end)

task.spawn(function()
    local t = 0; local lastSyncTime = 0
    RunService.RenderStepped:Connect(function(dt)
        if _G.TXR_ChatInstanceID ~= currentExecutionID or not gui.Parent then return end
        t = t + dt
        if mainFrame.Visible then
            local breath = (math.sin(t * 2.5) + 1) / 2
            aura.ImageTransparency = sharedEnv.TXR_State.isGhostMode and 0.95 or (0.85 + (breath * 0.05))
        end
    end)
    
    while _G.TXR_IsPolling and (_G.TXR_ChatInstanceID == currentExecutionID) and task.wait(0.4) do
        if req then
            local s, res = pcall(function() return req({ Url = SERVER_URL .. "/messages?since=" .. tostring(lastSyncTime), Method = "GET" }) end)
            if s and res and res.StatusCode == 200 then
                local ds, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
                if ds and type(data) == "table" then
                    for _, m in ipairs(data) do
                        if m.time >= lastSyncTime then
                            lastSyncTime = m.time
                            local rawUser = m.user:match("^(.-)::") or m.user
                            local uKey = (m.id and tostring(m.id)) or (m.user .. "_" .. m.time .. "_" .. m.msg)
                            if processedServerMessageMap[uKey] then continue end
                            if m.hidden then processedServerMessageMap[uKey] = true; continue end
                            
                            processedServerMessageMap[uKey] = true
                            local srvJob, cleanSrvMsg = m.msg:match("^%[SRV:(.-)%]%s*(.*)$")
                            local cleanGlbMsg = m.msg:match("^%[GLB%]%s*(.*)$")
                            local scope = "global"; local effMsg = m.msg
                            if srvJob then scope = "server"; effMsg = cleanSrvMsg; if srvJob ~= game.JobId then continue end
                            elseif cleanGlbMsg then scope = "global"; effMsg = cleanGlbMsg end

                            addMessageToFeed(m.user, effMsg, nil, false, m.jobId, scope)
                            if rawUser ~= lp.Name then playSFX("default") end
                        end
                    end
                end
            end
        end
    end
end)
