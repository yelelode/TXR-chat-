sharedEnv.TXR.sendMessageFunc = function(overrideText)
    local text = overrideText or chatInput.Text
    if not text or text == "TextBox" then return end
    text = string.gsub(text, "^%s+", ""); text = string.gsub(text, "%s+$", "")
    if text == "" or (tick() - lastSendTick < 0.15) then return end
    lastSendTick = tick()

    local pMatch = text:match("^!p%s+(%w+)")
    if pMatch then chatInput.Text = ""; sharedEnv.TXR_State.privateTarget = pMatch; return end

    local bioMatch = text:match("^!bio%s+(.+)")
    if bioMatch then
        chatInput.Text = ""; sharedEnv.TXR.socialData.bios[lp.Name:lower()] = bioMatch
        task.spawn(function() if req then pcall(function() req({ Url = SERVER_URL .. "/send", Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = HttpService:JSONEncode({ user = lp.Name .. "::" .. lp.DisplayName, msg = "[BIO:" .. bioMatch .. "]", jobId = game.JobId, hidden = true }) }) end) end end)
        return
    end

    local finalMsg = text
    if sharedEnv.TXR_State.privateTarget then finalMsg = "( 🔐 " .. lp.Name .. " Private " .. sharedEnv.TXR_State.privateTarget .. ") " .. text
    else finalMsg = (sharedEnv.TXR_State.chatMode == "server") and ("[SRV:" .. tostring(game.JobId) .. "] " .. text) or ("[GLB] " .. text) end

    if not overrideText then chatInput.Text = "" end
    local encodedUserTag = lp.Name .. "::" .. lp.DisplayName

    spawnUIParticles(sendBtn, UDim2.new(0.5, 0, 0.5, 0), Colors.Primary, 8)
    local cleanKey = string.lower(finalMsg); recentLocalSentMap[cleanKey] = tick()

    task.spawn(function()
